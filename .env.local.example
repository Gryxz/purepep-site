# PostHog EU — public write-only project key, safe to commit/embed.
# Leave unset to disable analytics entirely (provider becomes a no-op).
NEXT_PUBLIC_POSTHOG_KEY=

# ── Bankful Hosted Fields (browser-safe — tokenize only, cannot charge) ──
NEXT_PUBLIC_BANKFUL_SDK_URL=https://js.bankful.com/v1/hosted-fields.js
NEXT_PUBLIC_BANKFUL_HOSTED_FIELDS_KEY=pk_test_...
NEXT_PUBLIC_BANKFUL_ENV=sandbox

# ── Bankful charge proxy endpoint (WP mu-plugin — static export) ──
# Set to: https://woocommerce-1617574-6376231.cloudwaysapps.com/wp-json/purepep/v1/bankful-checkout
NEXT_PUBLIC_BANKFUL_CHECKOUT_ENDPOINT=

# ── Feature flags — keep false during underwriting to hide unfinished methods ──
NEXT_PUBLIC_SHOW_CRYPTO=false
NEXT_PUBLIC_SHOW_WIRE=false

